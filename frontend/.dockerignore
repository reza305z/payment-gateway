# Dependencies (installed inside the image, never copy from host)
node_modules/
.pnp/
.pnp.js
.pnpm-store/

# Next.js build output (generated inside the image)
.next/
out/
dist/
build/
.vercel/

# Environment files (avoid leaking secrets into the build context)
.env.local

# Debug and log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Git
.git/
.gitignore

# Docker files
Dockerfile*
.dockerignore

# Documentation (not needed in the image)
*.md

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db